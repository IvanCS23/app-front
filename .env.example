# Copia este archivo a .env.local y ajusta los valores.
# Las variables NEXT_PUBLIC_* se incrustan en el bundle del navegador:
# nunca pongas aquí llaves, tokens ni credenciales.

# URL base de la API Laravel (api-v1).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Fase 6.24 — Pantallas de demostración (maquetas que no guardan ni envían nada).
# false (por omisión): no aparecen en el menú, la Navbar, el Dashboard ni
#   Configuración; si alguien entra por URL ve el aviso de demostración.
# true: aparecen con la etiqueta "Demo".
# Se lee al compilar: reinicia `npm run dev` o vuelve a hacer `npm run build`.
NEXT_PUBLIC_SHOW_DEMO_SCREENS=false
